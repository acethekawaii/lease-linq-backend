# --------------------------------------------
# REQUIRED: BASIC APP SETTINGS
# --------------------------------------------
NODE_ENV="development"
PORT=3000

# --------------------------------------------
# PRINTER RELAY (H10S)
# --------------------------------------------
# Tokenless for now: leave PRINTER_DEVICE_TOKEN unset and the gateway accepts
# any agent. To lock it down later, set the SAME value here and in the Android
# app's agent_device_token (strings.xml).
# PRINTER_DEVICE_TOKEN=
# Device a job targets when none is specified; must match the Android
# agent_device_id. Defaults to "default" if unset.
PRINTER_DEFAULT_DEVICE_ID=default
# NOTE: PRINTER_BASE_URL is no longer used (relay replaced the HTTP bridge).

# --------------------------------------------
# REQUIRED: DATABASE SETTINGS
# --------------------------------------------
DATABASE_URL=
